# Normalize text files across Windows and macOS.
* text=auto eol=lf

# Windows-native scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicitly keep source, configuration, and Unity text assets as LF.
*.rs text eol=lf
*.cs text eol=lf
*.shader text eol=lf
