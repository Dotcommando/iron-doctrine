root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{rs,cs}]
indent_size = 4
max_line_length = 120

[*.rs]
# Rust formatting is ultimately enforced by rustfmt.
max_line_length = 100

[*.{json,jsonc,yaml,yml,toml}]
indent_size = 2

[*.{xml,props,targets,csproj}]
indent_size = 2

[*.{md,txt}]
max_line_length = 120

[*.md]
# Markdown may use two trailing spaces for an explicit line break.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 4

[Makefile]
indent_style = tab

[*.{shader,compute,cginc,hlsl}]
indent_size = 4

[*.{unity,prefab,asset,mat,anim,controller,overrideController,playable,meta,asmdef,asmref,inputactions}]
indent_size = 2

# Generated and vendored content should not be reformatted manually.
[client/Assets/ThirdParty/**]
generated_code = true

[client/Packages/**]
generated_code = true
